{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/professional",
      "destination": "/#professional",
      "permanent": false
    },
    {
      "source": "/cv",
      "destination": "/#professional",
      "permanent": false
    },
    {
      "source": "/cinematic",
      "destination": "/#cinematic",
      "permanent": false
    },
    {
      "source": "/3d",
      "destination": "/#cinematic",
      "permanent": false
    },
    {
      "source": "/resume",
      "destination": "/Anirudh_Khade_Resume.pdf",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*)\\.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/Anirudh_Khade_Resume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Anirudh_Khade_Resume.pdf\""
        }
      ]
    }
  ]
}